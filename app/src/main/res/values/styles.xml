<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>
    <style name="AppTheme.NoWindow">
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
    <style name="DefaultAlertDialogStyle" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="colorAccent">#33d9df</item>
        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:background">#FFFFFF</item>
        <item name="android:lineSpacingExtra">8dp</item>

    </style>
    <style name="MediaButton">
        <item name="background">@null</item>

    </style>
    <style name="liveButton">
        <item name="android:src">@drawable/ic_live</item>

    </style>
    <style name="FabStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">@dimen/margin_16</item>
        <item name="android:src">@drawable/ic_add_black</item>
        <item name="borderWidth">0dp</item>
        <item name="elevation">6dp</item>
        <item name="pressedTranslationZ">12dp</item>
        <item name="rippleColor">@android:color/white</item>
    </style>
    <style name="AppTheme.Launcher" parent="AppTheme">
    <item name="android:windowBackground">@drawable/splash_screen</item>

    </style>
    <style name="SwitchCompatTheme" >
        <item name="colorControlActivated">@color/colorAccent</item>
    </style>
    <style name="AlertDialogTheme" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme.backButtonColor" parent="android:Theme.Holo">
        <item name="android:homeAsUpIndicator">@color/white</item>
    </style>
<style name="AppTheme.Fullscreen" parent="AppTheme">
    <item name="android:windowNoTitle">true</item>
    <item name="android:windowFullscreen">true</item>
</style>

    <style name="SmallRating" parent="Base.Widget.AppCompat.RatingBar.Small">
        <item name="colorPrimary">@color/blue_text_color</item>
        <item name="colorPrimaryDark">@color/blue_text_color</item>
        <item name="colorAccent">@color/blue_text_color</item>
    </style>

    <style name="button_sign_in">
        <item name="android:layout_height">@dimen/height_48</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_marginStart">@dimen/margin_32</item>
        <item name="android:layout_marginLeft">@dimen/margin_32</item>
        <item name="android:textColor">@color/colorWhite</item>
        <item name="android:layout_marginEnd">@dimen/margin_32</item>
        <item name="android:fontFamily">@font/roboto_medium</item>
        <item name="android:textSize">@dimen/text_size_20</item>
        <item name="android:layout_marginRight">@dimen/margin_32</item>
        <item name="android:background">@drawable/bg_button_registration</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!--PROGRESSBAR-->
    <!--PROGRESSBAR-->
    <style name="QeasyProgressBarConatiner">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@color/colorTransparent</item>
        <item name="android:clickable">true</item>
    </style>

    <style name="QeasyProgressBar" parent="Widget.AppCompat.ProgressBar">
        <item name="android:layout_width">@dimen/height_60</item>
        <item name="android:layout_height">@dimen/height_60</item>
        <item name="android:layout_centerInParent">true</item>
        <item name="android:visibility">visible</item>
    </style>


</resources>
